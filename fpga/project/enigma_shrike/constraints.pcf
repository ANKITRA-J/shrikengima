# Pin constraint file for Shrike Fi board
# Target: Renesas FPGA (1120 LUTs)
# Pin mappings from Specification Section 2

# Clock and enable
set_io OSC_CLK -pin_name OSC_CLK
set_io OSC_EN -pin_name OSC_EN

# Runtime UART (ESP32-S3)
# ESP32 TX GPIO11 -> FPGA Pin 5 (RX)
# FPGA Pin 6 -> ESP32 RX GPIO13 (TX)
set_io uart_rx_pin 5
set_io uart_tx_pin 6

# LED output
set_io led_out GPIO16
set_io led_oe GPIO16_OE

# Clock constraint: 50MHz (20ns period)
set_frequency OSC_CLK 50
